; zscheme event library.
; Load stdlib, runtime, and avatar before this file.
; This layer owns both structured-data presentation and unsolicited event
; dispatch. Avatar commands reuse these formatters for solicited query replies.
;
; Keeping text here matters: runtime hands clients data, while this Zion-facing
; layer decides what a human sees. No string below is part of the wire contract.

;; ── Presentation helpers ────────────────────────────────────────────────────

(define (event-print text)
  (display text))

(define (event-list-lines title values render)
  ;; `render` keeps list framing separate from the kind-specific label choice.
  ;; Empty sections disappear instead of producing decorative blank headings.
  (let ((entries (event-list-values values)))
    (if (null? entries)
      ""
      (fold (lambda (value text)
              (string-append text "\n" (render value)))
            title
            entries))))

(define (event-exit-name exit)
  (if (map? exit)
    (map-ref exit "direction" (event-name exit))
    exit))

(define (event-who-name entry)
  (if (pair? entry)
    (event-name (cadr entry))
    (event-name entry)))

(define (event-exit-lines title exits)
  (let ((entries (cond ((map? exits) (map-keys exits))
                       ((list? exits) exits)
                       (else '()))))
    (if (null? entries)
      ""
      (fold (lambda (exit text)
              (string-append text "\n" (event-exit-name exit)))
            title
            entries))))

(define (event-look room)
  ;; A room snapshot is already the complete presentation model. Rendering it
  ;; needs no extra RPC and must not mutate the avatar's cached snapshot.
  (let ((name (map-ref room "name" (event-name room)))
        (description (map-ref room "description" ""))
        (occupants (occupant-pool room))
        (things (thing-pool room))
        (exits (exit-pool room)))
    (display
      (string-append
        name
        (if (string? description) (string-append "\n" description) "")
        (event-list-lines "\nOccupants:" occupants event-name)
        (event-list-lines "\nThings:" things event-name)
        (event-exit-lines "\nExits:" exits)))))

(define (event-exits exits)
  (display (string-append "Exits:" (event-exit-lines "" exits))))

(define (event-who occupants)
  (display (string-append "Here:" (event-list-lines "" occupants event-who-name))))

(define (event-occupants occupants)
  (display (string-append "Occupants:" (event-list-lines "" occupants event-name))))

(define (event-things things)
  (display (string-append "Things:" (event-list-lines "" things event-name))))

(define (room-child-upsert! ctx)
  (when (and (map? last-room) (map? ctx))
    (let ((actor (entry-actor ctx)))
      (when actor
        (set! last-room
          (map-set last-room "children"
            (cons ctx
                  (filter (lambda (child) (not (equal? (entry-actor child) actor)))
                          (room-child-pool last-room)))))))))

(define (room-child-remove! ctx)
  (when (and (map? last-room) (map? ctx))
    (let ((actor (entry-actor ctx)))
      (when actor
        (set! last-room
          (map-set last-room "children"
            (filter (lambda (child) (not (equal? (entry-actor child) actor)))
                    (room-child-pool last-room))))))))

(define (event-arrive ctx)
  (room-child-upsert! ctx)
  (display (string-append (event-name ctx) " arrives.")))

(define (event-leave ctx)
  (room-child-remove! ctx)
  (display (string-append (event-name ctx) " leaves.")))

(define (event-say ctx text)
  (display (string-append (event-name ctx) ": " text)))

(define (event-emote ctx text)
  (display (string-append (event-name ctx) " " text)))

; Personal completion events — clear pending entry, display failure if any.
(define (event-action-done action-ctx)
  (let ((id (map-ref action-ctx "id" #f))
        (status (map-ref action-ctx "status" "ok")))
    (when id (pending-clear! id))
    (when (not (equal? status "ok"))
      (display (string-append "Failed: " (map-ref action-ctx "reason" "unknown"))))))

(define event-put event-action-done)
(define event-take-done event-action-done)

(define (event-dig ctx direction)
  (guard (e (#t #f))
    (remember-room! (room-call "look")))
  (display (string-append (event-name ctx) " digs " direction ".")))

(define (event-fill ctx direction)
  (guard (e (#t #f))
    (remember-room! (room-call "look")))
  (display (string-append (event-name ctx) " fills " direction ".")))

(define (event-parent ctx)
  (handle-avatar-parent! ctx))

;; ── Data-directed event dispatch ────────────────────────────────────────────
;;
;; Adding a presentation-only event means defining one procedure and adding one
;; map entry. Membership events update cached children directly; topology
;; events replace the cache with a complete room snapshot.

(define event-handlers
  (make-map ":print" event-print
            ":arrive" event-arrive
            ":leave" event-leave
            ":say" event-say
            ":emote" event-emote
            ":dig" event-dig
            ":fill" event-fill
            ":parent" event-parent
            ":put-event" event-put
            ":take-event" event-take-done))

(define (on-event event args)
  ;; Unknown events are ignored: this client may be older than the actor that
  ;; sent them. Known handlers receive the event's argument list via `apply`.
  (let ((handler (map-ref event-handlers event #f)))
    (if handler (apply handler args) ())))
