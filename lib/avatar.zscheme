; zscheme avatar library.
; Vocabulary, name/DID resolution, and presentation.
; Load stdlib and runtime before this file.
; Routing (event-handlers, on-event) lives in events.zscheme, loaded after
; this file. All commands below resolve names/nicks to DIDs or DID-URLs
; before sending anything on the wire — never a bare name.
;
; This is policy and vocabulary, not runtime authority. Actors decide whether
; an operation is legal; the avatar only assembles pools, resolves a human word,
; and sends the ordinary actor verb.

;; ── Focus and room snapshot ─────────────────────────────────────────────────

(define (room) (#.my.ctx.room))

; R7RS `apply` spreads its trailing list argument, so this is exactly
; `(actor-call (room) method arg1 arg2 …)` for any number of caller args.
(define (room-call method . args)
  (apply actor-call (room) method args))

; Cache of the last `look` snapshot — the only source the resolver below
; searches without an extra round-trip.
(define last-room #f)

(define (remember-room! snapshot)
  (when (map? snapshot)
    (set! last-room snapshot))
  snapshot)

;; ── Name/DID resolver ──────────────────────────────────────────────────────
; All command verbs below resolve a typed word to a DID/DID-URL through this
; resolver before addressing anything directly. A bare `did:ma:` string always
; passes through unresolved.

; The pool consulted for a parent's own name: the current room's direct
; children (this includes containers, whose contents carry the container's
; DID as their own "parent") plus the inventory contents pool.
(define (location-lookup-pool)
  (append (if (map? last-room) (room-child-pool last-room) ())
          (resolve-inventory-pool)))

(define (candidate-location entry)
  (let* ((parent (map-ref entry "parent" #f))
         (parent-entry (and (string? parent) (find-entry-by-actor (location-lookup-pool) parent)))
         (parent-name (and (map? parent-entry) (map-ref parent-entry "name" #f))))
    (cond
      ((and (string? parent-name)
            (not (equal? parent-name ""))
            ; node-name falls back to the actor's own DID-URL for unnamed
            ; nodes; that is no name at all, so fall through to the
            ; "inventory" label instead of printing a bare DID.
            (not (equal? parent-name (entry-actor parent-entry))))
       parent-name)
      ((and (string? parent) (my-inv-if-any) (equal? parent (my-inv-if-any)))
       "inventory")
      ((and (string? parent)
            (map? last-room)
            (equal? parent (map-ref last-room "actor" #f)))
       (let ((room-name (map-ref last-room "name" #f)))
         (if (and (string? room-name) (not (equal? room-name "")))
           room-name
           #f)))
      (else #f))))

(define (describe-candidate entry)
  (let ((nick (map-ref entry "nick" #f))
        (location (candidate-location entry)))
    (string-append (map-ref entry "name" (entry-actor entry))
                   (if (and (string? nick) (not (equal? nick "")))
                       (string-append " \"" nick "\"")
                       "")
                   " (" (entry-actor entry) ")"
                   (if location (string-append " in " location) ""))))

; Ambiguity is the user's problem to resolve, not ours to guess at: list every
; candidate's DID so they can repeat the command unambiguously.
(define (ambiguous-error word candidates)
  (error
    (fold (lambda (candidate text) (string-append text "\n  " (describe-candidate candidate)))
          (string-append "\"" word "\" matches more than one — repeat the command with a DID instead:")
          candidates)))

(define (no-match-error word)
  (error (string-append "no match for \"" word "\" here.")))

; A room publishes one authoritative child list. Every resolver and
; presentation view derives from it rather than maintaining kind-specific
; copies that can diverge.
(define (room-child-pool room)
  (event-list-values (map-ref room "children" ())))

(define (room-child-kind-pool room kind)
  (filter (lambda (entry) (equal? (map-ref entry "kind" "") kind))
          (room-child-pool room)))

; person == h00man: the people one can meaningfully talk to (or give to).
(define (person-pool room)
  (room-child-kind-pool room "h00man"))

; Occupant kinds: h00man direct-DID presence plus runtime agents. The room's
; `who?` view narrows this to h00man only; this pool feeds "Occupants:"
; presentation.
(define occupant-kinds (list "agent" "h00man"))

(define (occupant-pool room)
  (filter (lambda (entry)
            (member? (map-ref entry "kind" "") occupant-kinds))
          (room-child-pool room)))

(define (thing-pool room)
  (filter (lambda (entry)
            (member? (map-ref entry "kind" "") (list "thing" "container")))
          (room-child-pool room)))

(define (exit-pool room) (room-child-kind-pool room "exit"))

; Cheap first (search what we already have cached), fresh only if needed:
; one `look` round-trip at most per resolve, never one per candidate.
; Returns #f rather than erroring when nothing matches here, so a caller can
; chain another pool (see resolve-ref below) before finally giving up.
(define (resolve-against-or-false pool-getter word keys)
  (let* ((pool1 (if (map? last-room) (pool-getter last-room) ()))
         (hit1 (candidates-by-keys word pool1 keys)))
    (if (not (null? hit1))
      hit1
      (let* ((room2 (remember-room! (room-call "look")))
             (pool2 (if (map? room2) (pool-getter room2) ())))
        (candidates-by-keys word pool2 keys)))))

(define (resolve-against pool-getter word keys)
  (if (starts-with-did? word)
    word
    (let ((candidates (resolve-against-or-false pool-getter word keys)))
      (cond ((null? candidates) (no-match-error word))
            ((null? (cdr candidates)) (entry-actor (car candidates)))
            (else (ambiguous-error word candidates))))))

; The runtime-layer contract is defined in runtime.zscheme, not here. The
; avatar layer decides which candidate pool to search (room snapshot, inventory,
; etc.) and then delegates to the shared runtime resolver so all object actions
; use the same DID-list contract.
(define (resolve-room-pool)
  (let* ((room1 (if (map? last-room) last-room (remember-room! (room-call "look"))))
         (pool1 (if (map? room1) (room-child-pool room1) ())))
    pool1))

; The inventory container itself is a resolvable candidate beside its contents,
; so `equip chest from vadsæk` / `take coin from vadsæk` work when the source
; is your own carried inventory. `inv-entry` is the ctx cached when the
; container was booked; after a reload only the DID is known, so the
; container's own :name answers for it (inventory-display-ctx) and the bare
; DID stays the reliable spelling when even that fails.
(define inv-entry #f)

(define (resolve-inventory-pool)
  (let ((inv (usable-inventory)))
    (if inv
      (let ((contents (guard (e (#t ())) (container-contents inv))))
        (if (and (map? inv-entry) (equal? (entry-actor inv-entry) inv))
          (cons inv-entry contents)
          (cons (inventory-display-ctx inv) contents)))
      ())))

(define held-item #f)
(define (hand-pool) (if held-item (list held-item) ()))
(define (held-clear!) (set! held-item #f))
(define (held-add! ctx)
  (let ((actor (entry-actor ctx)))
    (when (string? actor)
      (set! held-item ctx))))

; The default candidate pool for a bare name: every child in the room plus
; everything in the configured inventory container.
(define (default-pool)
  (append (hand-pool) (append (resolve-room-pool) (resolve-inventory-pool))))

; The single place that turns (word, pool) into one resolved entry or raises
; no-match/ambiguous — never builds the pool itself; every caller assembles
; its own candidate list first and hands it in here. The word "inventory" is
; not special: it resolves like any other name, against the supplied pool.
(define (resolve-one-entry word pool)
  (if (starts-with-did? word)
    (candidate-for-did pool word)
    (let ((hits (resolve-ref word pool)))
      (cond ((null? hits) (no-match-error word))
            ((null? (cdr hits)) (candidate-for-did pool (car hits)))
            (else (ambiguous-error word (map (lambda (did) (candidate-for-did pool did)) hits)))))))

; Membership events maintain `last-room` directly and topology events replace
; it from `look`, but a client can still miss an event while disconnected.
; Every default-pool/room-pool-based resolver therefore retries once against a
; fresh room before reporting no-match.
(define (resolve-one-entry-fresh word pool-thunk)
  (guard (e ((string-contains e "no match for")
             (remember-room! (room-call "look"))
             (resolve-one-entry word (pool-thunk)))
            (#t (error e)))
    (resolve-one-entry word (pool-thunk))))

(define (resolve-one word)
  (if (starts-with-did? word)
    word
    (entry-actor (resolve-one-entry-fresh word default-pool))))

(define (bare-did? value)
  (and (starts-with-did? value) (not (string-contains value "#"))))

(define (resolve-person-pool)
  (let ((room1 (if (map? last-room) last-room (remember-room! (room-call "look")))))
    (if (map? room1) (person-pool room1) ())))

(define (resolve-person word)
  (let* ((entry (resolve-one-entry-fresh word resolve-person-pool))
         (did (entry-actor entry)))
    (cond ((not (equal? (map-ref entry "kind" "") "h00man"))
           ; A DID/DID-URL word that matches no pool entry gets a synthetic
           ; fallback entry from candidate-for-did; only a genuine h00man
           ; member of the room is a valid recipient.
           (error (string-append "\"" word "\" is not a person.")))
          ((equal? did (#.my.identity.did))
           (error "you can't give something to yourself."))
          (else did))))

; The ordinary object-command boundary. Every caller supplies a human object
; reference first; resolution, no-match, and ambiguity are handled here before
; the method and its remaining parameters are sent to the chosen actor.
(define (command object method . params)
  (apply actor-call (resolve-one object) method params))

; Resolve a word against an arbitrary caller-supplied pool (e.g. drop's
; hand+inventory search space) rather than the default room+inventory pool.
(define (resolve-in-given-pool word pool)
  (entry-actor (resolve-one-entry word pool)))

; Exits match on their direction word first ("north"), falling back to any
; nick/name they might also carry.
(define (resolve-exit word) (resolve-against exit-pool word (list "direction" "nick" "name")))

; A container's own contents aren't in any room snapshot — the container has
; to be asked directly, exactly like resolving anything else that isn't here.
; ":contents?" replies with the raw list of content ctx's, not "look"'s text.
(define (container-contents container)
  (event-list-values (actor-call container "contents?")))

(define (resolve-in-container word container)
  (if (starts-with-did? word)
    word
    (let ((candidates (candidates-by-keys word (container-contents container) (list "nick" "name"))))
      (cond ((null? candidates) (no-match-error word))
            ((null? (cdr candidates)) (entry-actor (car candidates)))
            (else (ambiguous-error word candidates))))))

;; ── Entry and local context ─────────────────────────────────────────────────
; `:enter`/`:traverse` replies carry the new room ctx. Store its parent and
; nick locally; the actor tree is updated by the parent/child handshake.

; `(#.my.path: value)` is the local config *setter* (trailing colon on the
; path atom); `(#.my.path:)` with no value is the *delete* form — used below
; to clear a stale nick when the new room ctx doesn't give us one.
(define (apply-entry-ctx! ctx)
  (when (map? ctx)
    (let ((parent (map-ref ctx "parent" #f)))
      (when parent
        (#.my.ctx.room: parent)))
    (let ((nick (map-ref ctx "nick" #f)))
      (if (and (string? nick) (not (equal? nick "")))
        (#.my.ctx.nick: nick)
        (#.my.ctx.nick:))))
  ctx)

; Reading an unset local path raises, so every optional profile field needs a
; fallback rather than a bare get.
(define (local-string thunk fallback)
  (let ((value (guard (e (#t #f)) (thunk))))
    (if (and (string? value) (not (equal? value ""))) value fallback)))

; This avatar's own child ctx, in the shape every node reports to its parent.
; A bare DID has no identity entity, so the client assembles it here. The kind
; is "h00man" — the human presence kind — while "protocol" stays the generic
; agent protocol: no new /ma/* protocol is being introduced, only the kind.
(define (my-node-ctx)
  (let* ((did (#.my.identity.did))
         (name (local-string (lambda () (#.my.profile.name)) did))
         (nick (local-string (lambda () (#.my.ctx.nick)) name)))
    (make-map "actor" did
              "did" did
              "parent" (room)
              "kind" "h00man"
              "protocol" "/ma/agent/0.0.1"
              "name" name
              "nick" nick
              "description" (local-string (lambda () (#.my.profile.description))
                                          "A direct DID presence."))))

; A roll-call is the parent recounting its children. Answer it the way every
; other node does: reannounce to our own cached parent, ignoring the caller.
(define (announce-avatar-parent!)
  (when (starts-with-did? (guard (e (#t #f)) (room)))
    (actor-call (room) "parent" (my-node-ctx)))
  nil)

; The inventory pointer is read-only here — never forges — so a mere name
; lookup (e.g. resolve-name's inventory fallback, or a bare `inv`) can't have
; the side effect of creating a fresh "inventory" container under the runtime
; root. Booking an inventory container is equip's job, never a view's.
(define (my-inv-if-any)
  (guard (e (#t #f))
    (let ((existing (#.my.ctx.inv)))
      ; reject stale non-DID values so usable-inventory never calls actor-call on garbage
      (if (starts-with-did? existing)
        existing
        #f))))

; A configured inventory is usable only while its actor remains a container.
; Commands call this at their routing boundary, so stale local state falls back
; to ordinary hand behaviour instead of becoming a hidden transfer target.
(define (usable-inventory)
  (let ((inventory (my-inv-if-any)))
    (if inventory
      (guard (e (#t #f))
        (if (equal? (actor-call inventory "kind?") "/ma/container/0.0.1")
          inventory
          #f))
      #f)))

; After a reload only the inventory DID is known — the ctx snapshot is cached
; in memory at booking time, and only the DID is persisted. Every node answers
; the generic :name RPC, so the container itself supplies the display name; a
; synthetic ctx naming the DID is the final fallback when it can't answer. The
; generic getter reports "(none)" for an unnamed actor, which is no better than
; the DID — treat it as missing.
(define (inventory-display-ctx inventory)
  (let ((name (guard (e (#t #f)) (actor-call inventory "name"))))
    (if (and (string? name)
             (not (equal? name ""))
             (not (equal? name "(none)")))
      (make-map "actor" inventory "name" name)
      (make-map "actor" inventory "name" inventory))))

      ;; ── World-building and movement verbs ──────────────────────────────────────
      ;;
      ;; Everything below is intentionally thin. Resolve locally, make one ordinary
      ;; actor call, and let the authoritative actor return data or an error.

; Movement is a two-hop relay (ma-spec sec 4), not one message: the exit
; itself decides where "through" leads (and may refuse — a locked door just
; echoes the *same* room back as `parent` along with blocking text), then a
; *second*, separate `:enter` against the returned room is what actually
; completes the move. There is no single "move me" verb anywhere in the spec.
; The exit's `:traverse` takes a transient ctx map `{did, parent}` — the
; traveller's own bare DID and its current room — never a bare DID string.
; A locked exit admits a traveller who supplies the stored lock secret:
; `go <direction> <secret>` passes it along as the second traverse argument.
(define (go direction . secret-words)
  (let* ((exit (resolve-exit direction))
         (ctx (make-map "did" (#.my.identity.did) "parent" (room)))
         (result (if (null? secret-words)
                     (actor-call exit "traverse" ctx)
                     (actor-call exit "traverse" ctx (join-words secret-words)))))
    (if (map? result)
      (let ((parent (map-ref result "parent" #f)))
        ; A locked exit (or one that leads nowhere) echoes the source room
        ; back as `parent` and narrates the refusal itself as a :say event —
        ; only a *different* parent room completes the move, so a same-room
        ; reply is neither re-entered nor re-printed here.
        (if (and parent (not (equal? parent (room))))
          (enter parent (#.my.ctx.nick))
          #f))
      (display result)))
  nil)
(define (dig . args)
  (apply room-call "dig" args))

(define (fill direction)
  (room-call "fill" direction))

;; ── Command grammar ──────────────────────────────────────────────────────────
;; The reserved-keyword commands (`take … from …`, `put … in …`, `give … to …`,
;; `tell … to …`, `name … as …`) all share one shape: words split by a hard
;; separator keyword. This is the single grammar primitive; each command names
;; its keyword, whether the trailing slot is required, and its usage text.

; Split `words` on `keyword`. Raises `usage-text` when the slot before the
; keyword is empty, when a required keyword is missing, or when the keyword is
; present but followed by no words. Returns (list before after) where `after`
; is #f when the keyword is absent.
(define (split-command! words keyword usage-text required?)
  (let ((before (words-before-keyword words keyword))
        (after (words-after-keyword words keyword)))
    (when (or (null? before)
              (and required? (not after))
              (null? after))
      (error usage-text))
    (list before after)))

(define forge-usage "usage: forge <kind> named <name...>")

; Direct child creation (ma-spec sec 7) — no avatar mediation on the runtime
; side. The reply payload is the new entity's DID-URL. A forged entity is
; always born into its forger's hand: the creating room sets parent to this
; avatar, and the new actor's genesis announces itself (announce-node-parent!
; in its init), so the ordinary :parent handshake books it as held here —
; there is no `in <target>`, and a locked or closed container never enters the
; picture. The hand is cleared first (drop-held-to-room!), exactly like take,
; so the slot is ready when the forged thing's proposal arrives. "named" is a
; keyword, not data, so a multi-word name never needs quoting:
; `forge lamp named Brass Lamp`.
(define (forge kind . rest)
  (if (or (null? rest) (not (equal? (car rest) "named")))
      (error forge-usage)
      (let ((name (join-words (cdr rest))))
        (if (starts-with-did? name)
            (error "name must not be a DID or DID-URL")
            (begin
              (drop-held-to-room!)
              (display (command (room) "forge" (make-map "kind" kind "name" name)))))
        nil)))

(define (leave)
  (room-call "leave"))

; Trigger the current room to re-announce its own `:here` cascade to all
; current children. This is the avatar-side convenience wrapper that fires the
; room's own authoritative same-room propagation, not a generic parent check.
(define (start-here)
  (let ((room-did (room)))
    (when (string? room-did)
      (room-call "here" room-did))
    nil))

(define (enter target nick)
  (let ((result (apply-entry-ctx! (actor-call target "enter" nick))))
    (if (map? result) (look) (display result)))
  nil)

;; ── Parent/child transfer handshake ─────────────────────────────────────────
;; The actor ctx is the only transfer state. No local hold slot or queue is
;; maintained here.

; A container booked by `equip` awaits its :parent proposal; when it arrives it
; is acknowledged and routed to the inventory slot instead of the held slot.
(define equip-pending #f)

(define (handle-avatar-parent! ctx)
  (let ((parent (map-ref ctx "parent" ""))
        (actor (map-ref ctx "actor" ""))
        (self (#.my.identity.did)))
    (cond
      ((and (equal? actor equip-pending) (equal? parent self))
       (actor-call actor "child" ctx)
       (set! equip-pending #f)
       ; The container moved from the hand to the inventory slot: if it was
       ; the held item, free the hand. A stale held slot pointing at the
       ; inventory container would make the next take drop it to the room.
       (when (and held-item (equal? actor (entry-actor held-item)))
         (held-clear!))
       (book-inventory! actor ctx))
      ; A take-then-drop item (`drop <item> from <container>`): acknowledge
      ; the hold proposal so the item commits to us — the ordinary prerequisite
      ; for the avatar to be authorised to relocate it — then immediately drop
      ; it to the room.
      ((and (equal? parent self) (map-ref drop-pending actor #f))
       (set! drop-pending (map-delete drop-pending actor))
       (actor-call actor "child" ctx)
       (drop-target-to-room! actor))
      ((equal? parent self)
       (actor-call actor "child" ctx)
       ; The equipped inventory container may re-propose (e.g. a repeated
       ; :hold racing its booking); it belongs in the inventory slot, never
       ; the hand slot — a held slot pointing at it would make the next take
       ; drop it to the room. A re-proposal also refreshes the cached ctx so
       ; inv-entry never goes stale while the container stays equipped.
       (if (equal? actor (my-inv-if-any))
         (set! inv-entry ctx)
         (held-add! ctx)))
      ; The old parent's own confirmation that a committed transfer actually
      ; happened (node.ma's commit-node-parent!) — the only trustworthy signal
      ; that we're no longer holding it, so callers never clear held-item
      ; themselves before the move is confirmed.
      ((and held-item (equal? actor (entry-actor held-item)))
       (held-clear!)))))

(define (hold-target! target)
  (actor-call target "hold"))

; Failures against a possibly-unreachable actor bubble up as opaque transport
; errors (e.g. an outbox-open timeout); this puts the user's own words back
; in front so the message says what they were trying to do.
(define (with-action-context description thunk)
  (guard (e (#t (error (string-append description " — " e))))
    (thunk)))

; Room-relocate the currently held item to make room for a new pick-up. The
; inventory container is never a held item: a stale hand slot that still points
; at it must not drop the user's equipped inventory — the new item's :parent
; proposal overwrites the slot instead. Explicit `drop` keeps its own inline
; logic because dropping the inventory container there is the user's choice.
(define (drop-held-to-room!)
  (when held-item
    (let ((current (entry-actor held-item)))
      (unless (equal? current (my-inv-if-any))
        (actor-call (room) "drop" current)
        (actor-call current "set-parent" (room))))))

(define take-usage "usage: take <item...> [from <container...>]")

; Take without `from` sends the ownership-blind :hold trigger directly to a
; room child. Taking from a container uses the container's lock/contents gate;
; root then asks the item to propose itself to this avatar.
(define (take . words)
  ; A stale equip booking must never capture this command's :parent proposal.
  (set! equip-pending #f)
  (let* ((s (split-command! words "from" take-usage #f))
         (item-words (car s))
         (container-words (cadr s)))
    (if container-words
      (with-action-context
        (string-append "could not take " (join-words item-words) " from " (join-words container-words))
        (lambda ()
          (let* ((container (resolve-one (join-words container-words)))
                 (item (resolve-in-container (join-words item-words) container)))
            (drop-held-to-room!)
            (let ((id (actor-call container "take" item)))
              (when (string? id) (pending-store! id)))
            nil)))
      (with-action-context
        (string-append "could not take " (join-words item-words))
        (lambda ()
          (let ((entry (resolve-one-entry-fresh (join-words item-words) resolve-room-pool)))
            (drop-held-to-room!)
            (hold-target! (entry-actor entry))
            nil))))))

(define equip-usage "usage: equip <container...> [from <container...>]")

; equip is take's sister: the same grammar, resolution, and pick-up RPC, but
; the container is booked into the inventory slot instead of the held slot (see
; book-inventory!). `from` goes through the source container's :take lock gate,
; so a container nested in your inventory is only ever taken out through the
; container's own admission rules.
(define (equip . words)
  (let* ((s (split-command! words "from" equip-usage #f))
         (item-words (car s))
         (container-words (cadr s)))
    (if container-words
      (with-action-context
        (string-append "could not equip " (join-words item-words) " from " (join-words container-words))
        (lambda ()
          (let* ((source (resolve-one (join-words container-words)))
                 (item (resolve-in-container (join-words item-words) source)))
            (equip-propose! item (lambda () (actor-call source "take" item))))))
      (with-action-context
        (string-append "could not equip " (join-words item-words))
        (lambda ()
          (let ((entry (resolve-one-entry-fresh (join-words item-words) equip-pool)))
            (equip-propose! (entry-actor entry) (lambda () (hold-target! (entry-actor entry))))))))))

; equip's search space: the room (like take) plus your hand, so `equip` works
; on something you already took. Containers nested in your inventory go through
; the `from` form, where the source container's own :take gate applies.
(define (equip-pool)
  (append (hand-pool) (resolve-room-pool)))

; Shared equip tail: kind-gate, arm the pending route, then trigger the same
; pick-up take uses (:hold from room/hand, :take from a container). A refusal
; clears the pending flag and propagates the actor's error.
;
; Equipping the container that is already the inventory is a deliberate no-op —
; no re-hold or re-book — so a racing :parent re-proposal can never churn the
; slot. Otherwise a new container first unequips the old one — it lands in the
; hand — and the ordinary make-room step take uses then drops it to the room.
; The equipped container is never a special case for drop itself.
(define (equip-propose! did propose)
  (if (equal? did (my-inv-if-any))
    nil
    (let ((kind (actor-call did "kind?")))
      (if (equal? kind "/ma/container/0.0.1")
        (begin
          (set! equip-pending did)
          (guard (e (#t (set! equip-pending #f) (error e)))
            (let ((old (my-inv-if-any)))
              (when old
                (drop-held-to-room!)
                (unequip-to-hand! old)))
            (unless (and held-item (equal? did (entry-actor held-item)))
              (drop-held-to-room!))
            (propose)))
        (error (string-append "invalid inventory kind: " kind)))))
  nil)

(define keep-usage "usage: keep [<item>]")

; keep stows the held item inside the equipped inventory container. The item is
; already parented to this avatar, so no pick-up RPC is needed — keep issues
; the same :put request `put <item> in <inventory>` sends, with the target
; container implicit. The container's own gate and the ordinary parent/child
; handshake (including the old-parent :parent confirmation that clears the
; held slot) carry the actual move.
(define (keep . rest)
  (if (not held-item)
    (error "you're not holding anything")
    (let* ((target (entry-actor held-item))
           (matched? (if (null? rest)
                       #t
                       (guard (e (#t #f))
                         (equal? target (resolve-in-given-pool (join-words rest) (hand-pool)))))))
      (if (not matched?)
        (error (string-append "you're not holding " (join-words rest)))
        (with-action-context
          (if (null? rest) "could not keep it" (string-append "could not keep " (join-words rest)))
          (lambda ()
            (let ((inventory (my-inv-if-any)))
              (if (not inventory)
                (error "no inventory equipped")
                (let ((id (actor-call target "put" inventory)))
                  (when (string? id) (pending-store! id))))
              nil)))))))

; Unequip is keep's mirror image: the equipped inventory container leaves the
; inventory slot and lands in the hand. It is already parented to this avatar,
; so no pick-up RPC is needed — only the slot bookkeeping. Whatever is in the
; hand is dropped to the room first, so the container always lands in a free
; hand. An optional name must resolve to the equipped container itself.
(define unequip-usage "usage: unequip [<inventory>]")

(define (unequip . rest)
  (let ((inventory (my-inv-if-any)))
    (if (not inventory)
      (error "no inventory equipped")
      (let ((matched? (if (null? rest)
                         #t
                         (guard (e (#t #f))
                           (equal? inventory
                                   (resolve-in-given-pool (join-words rest)
                                                          (resolve-inventory-pool)))))))
        (if (not matched?)
          (error (string-append (join-words rest) " is not your equipped inventory"))
          (with-action-context
            (if (null? rest)
              "could not unequip it"
              (string-append "could not unequip " (join-words rest)))
            (lambda ()
              (drop-held-to-room!)
              (unequip-to-hand! inventory)
              nil)))))))

; One inventory slot: booking a new container drops the previous one to the
; room (if any and different) with the same room-drop + set-parent relocation
; every other drop path uses. `ctx` is the container's own ctx; it is cached
; as inv-entry so the resolver can match the inventory container by name.
(define (book-inventory! did ctx)
  (let ((old (my-inv-if-any)))
    (when (and old (not (equal? old did)))
      (actor-call (room) "drop" old)
      (actor-call old "set-parent" (room))))
  (set! inv-entry ctx)
  (#.my.ctx.inv: did)
  (display (string-append "inventory set to " did)))

; The shared unequip slot move: the equipped container leaves the inventory
; slot and lands in the held slot. Pure bookkeeping — it is already parented
; to this avatar, so no pick-up RPC is needed.
(define (unequip-to-hand! inventory)
  (held-add! (or inv-entry (inventory-display-ctx inventory)))
  (set! inv-entry #f)
  (#.my.ctx.inv:))

; A cheat: locate an object by its bare DID even though it never surfaces in
; `look`/`inv` (e.g. it isn't a child of the current room or your inventory
; the resolver already searches). Only takes it if it's actually within reach
; right now — the room, you, or your inventory — never anywhere else.
(define (find did)
  (set! equip-pending #f)
  (if (not (starts-with-did? did))
    (error "usage: find <did>")
    (with-action-context (string-append "could not find " did)
      (lambda ()
        (let ((parent (actor-call did "parent?")))
          (if (or (equal? parent (room))
                  (equal? parent (#.my.identity.did))
                  (and (my-inv-if-any) (equal? parent (my-inv-if-any))))
            (begin
              (drop-held-to-room!)
              (hold-target! did)
              (display (string-append "You found " (actor-call did "name") "."))
              nil)
            (error "it's not here")))))))

(define (take-from container name)
  (with-action-context
    (string-append "could not take " name " from " container)
    (lambda ()
      (let* ((source (resolve-one container))
             (item (resolve-in-container name source)))
        (drop-held-to-room!)
        (let ((id (actor-call source "take" item)))
          (when (string? id) (pending-store! id)))
        nil))))

; Drop's search space: what you're holding, everything in the equipped
; inventory, and the contents of the containers inside that inventory — one
; nesting level, enough to reach a bag packed inside the rucksack.
(define (drop-pool)
  (let ((inventory (resolve-inventory-pool)))
    (if (null? inventory)
      (hand-pool)
      (append (hand-pool)
              (append inventory
                      (flatten-list
                        (map (lambda (entry)
                               (guard (e (#t ()))
                                 (container-contents (entry-actor entry))))
                             (cdr inventory))))))))

; The source container in `drop <item> from <container>` has the same
; reachability take-from already offers — the room, your hand, the equipped
; inventory and the containers packed inside it.
(define (drop-container-pool)
  (append (resolve-room-pool) (drop-pool)))

; Room-relocate an actor the avatar is already parent to: the room :drop
; capacity pre-check, then the ordinary :set-parent relocation every drop
; path uses. Dropping the equipped inventory container also unbooks it.
(define (drop-target-to-room! target)
  (actor-call (room) "drop" target)
  (actor-call target "set-parent" (room))
  (when (equal? target (my-inv-if-any)) (#.my.ctx.inv:)))

; `drop <item> [from <container>]` whose item lives inside a container is
; take-then-drop: the item leaves through the container's own :take gate,
; and when its :parent proposal arrives (handle-avatar-parent!) it is
; acknowledged and immediately relocated to the room. drop-pending is keyed
; by item DID so that handshake can recognise the item; the command boundary
; clears the entry if the gate refuses, so a stale entry can never hijack a
; later, unrelated proposal.
(define drop-pending (make-map))

(define (take-then-drop! container item)
  (set! drop-pending (map-set drop-pending item #t))
  (guard (e (#t (set! drop-pending (map-delete drop-pending item)) (error e)))
    (let ((id (actor-call container "take" item)))
      (when (string? id) (pending-store! id)))))

(define drop-usage "usage: drop [<item...>] [from <container...>]")

; Drop by name: the item may be held, inside the equipped inventory, or
; inside a container packed in that inventory. Held items drop directly;
; inventory items go through their container's :take gate and then drop to
; the room (take-then-drop!).
(define (drop . rest)
  (if (null? rest)
    (if (not held-item)
      (error "you're not holding anything")
      (with-action-context "could not drop it"
        (lambda ()
          (drop-target-to-room! (entry-actor held-item))
          nil)))
    (let* ((s (split-command! rest "from" drop-usage #f))
           (item-words (car s))
           (container-words (cadr s)))
      (if container-words
        (with-action-context
          (string-append "could not drop " (join-words item-words) " from " (join-words container-words))
          (lambda ()
            (let* ((container (resolve-one-entry-fresh (join-words container-words) drop-container-pool))
                   (item (resolve-in-container (join-words item-words) (entry-actor container))))
              (take-then-drop! (entry-actor container) item)
              nil)))
        (with-action-context
          (string-append "could not drop " (join-words item-words))
          (lambda ()
            (let* ((entry (resolve-one-entry-fresh (join-words item-words) drop-pool))
                   (target (entry-actor entry)))
              (cond ((and held-item (equal? target (entry-actor held-item)))
                     (drop-target-to-room! target))
                    ((equal? target (my-inv-if-any))
                     (drop-target-to-room! target))
                    ((string? (map-ref entry "parent" #f))
                     (take-then-drop! (map-ref entry "parent") target))
                    (else (error (string-append "you're not holding " (join-words item-words)))))
              nil)))))))

  ;; ── Direct object verbs ─────────────────────────────────────────────────────

(define put-usage "usage: put <item...> in <container...>")

(define pending-actions (make-map))

(define (pending-store! id)
  (set! pending-actions (map-set pending-actions id #t)))

(define (pending-clear! id)
  (set! pending-actions (map-delete pending-actions id)))

; Like forge/tell, `in` is a hard separator so both references may use their
; human-readable multi-word names. The item itself initiates the put request;
; actor authority and container admission remain runtime decisions.
(define (put . words)
  (let* ((s (split-command! words "in" put-usage #t))
         (item-words (car s))
         (container-words (cadr s)))
    (with-action-context
      (string-append "could not put " (join-words item-words) " in " (join-words container-words))
      (lambda ()
        (let* ((item-entry (resolve-one-entry-fresh (join-words item-words) default-pool))
               (item (entry-actor item-entry))
               (container (resolve-one (join-words container-words))))
          (let ((id (actor-call item "put" container)))
            (when (string? id) (pending-store! id)))
          nil)))))

(define (put-in . words)
  (apply put words))

(define (recycle-from container name)
  (with-action-context (string-append "could not recycle " name " from " container)
    (lambda ()
      (command (resolve-in-container name (resolve-one container)) "recycle")
      nil)))

; A roll-call is node policy; this is only the human spelling of it. The phase
; and its optional timeout are peeled off the END so a multi-word object needs
; no quoting, exactly like forge's named/in split. No object means this room.
(define (roll-call-seconds? word)
  (or (number? word)
      (and (string? word) (string->number word))))

(define (roll-call-split words)
  (let* ((n (length words))
         (last1 (if (> n 0) (list-ref words (- n 1)) #f))
         (last2 (if (> n 1) (list-ref words (- n 2)) #f)))
    (cond ((equal? last1 "end")
           (list (take (- n 1) words) (list "end")))
          ((and (roll-call-seconds? last1) (equal? last2 "begin"))
           (list (take (- n 2) words) (list "begin" last1)))
          ((equal? last1 "begin")
           (list (take (- n 1) words) (list "begin")))
          (else (list words (list "begin"))))))

(define (roll-call . words)
  (let* ((parts (roll-call-split words))
         (object-words (car parts))
         (phase-args (car (cdr parts))))
    (display
      (if (null? object-words)
        (apply room-call "roll-call" phase-args)
        (apply command (join-words object-words) "roll-call" phase-args))))
  nil)

(define (say . words)
  (room-call "say" (join-words words))
  nil)

(define (emote . words)
  (room-call "emote" (join-words words))
  nil)

(define (claim-usage-error)
  (error "usage: claim <object> [secret]"))

(define (claim . args)
  (cond
    ((null? args) (claim-usage-error))
    ((or (null? (cdr args)) (null? (cddr args)))
     (apply command (car args) "claim" (cdr args))
     nil)
    (else (claim-usage-error))))

(define give-usage "usage: give <object...> to <person...>")

(define (claim-secret)
  (string-append
    (number->string (random 9223372036854775807)) "-"
    (number->string (random 9223372036854775807)) "-"
    (number->string (random 9223372036854775807))))

; Giving is an offer, not a unilateral ownership change. The current owner
; installs a one-time recovery secret, then sends the recipient an ordinary
; inbox message. Nothing changes until that person runs the included claim.
(define (give . words)
  (let* ((s (split-command! words "to" give-usage #t))
         (object-words (car s))
         (person-words (cadr s))
         (object-text (join-words object-words))
         (object-entry (resolve-one-entry-fresh object-text default-pool))
         (object (entry-actor object-entry))
         (recipient (resolve-person (join-words person-words))))
    (if (or (bare-did? object) (not (starts-with-did? object)))
      (error (string-append "\"" object-text "\" is not an object."))
      (let* ((token (claim-secret))
             (giver-entry (candidate-for-did (person-pool last-room) (#.my.identity.did)))
             (message (string-append
                        (event-name giver-entry) " wants to give you "
                        (event-name object-entry) ". Accept with: claim "
                        object " " token)))
        (actor-call object "set-recovery-secret" token)
        (let ((sent (msg-send recipient message)))
          (if (ok? sent) nil (error (err-msg sent))))))))

(define (owner name)
  (display (command name "owner?"))
  nil)

;; ── Locking ─────────────────────────────────────────────────────────────────
; lock/unlock are owner-gated at the actor, and `:lock <secret>` is the same
; contract for containers and exits: the owner (or, for an exit, the room that
; owns it) locks with an optional secret that lets a non-owner `unlock` — or,
; for an exit, pass straight through with `go <direction> <secret>`. Exits
; accept lock commands only from their source room, so the command routes
; through the room's owner-gated `:exit <direction> <verb>` proxy using the
; exit's direction; everything else is addressed directly.
(define lock-usage "usage: lock <target...> [with <secret>]")
(define unlock-usage "usage: unlock <target...> [with <secret>]")

(define (lock-rpc! words usage verb)
  (let* ((s (split-command! words "with" usage #f))
         (target-words (car s))
         (secret-words (cadr s))
         (target (join-words target-words))
         (entry (resolve-one-entry-fresh target default-pool))
         (args (if secret-words (list (join-words secret-words)) ())))
    (if (equal? (map-ref entry "kind" "") "exit")
      (apply room-call "exit" (cons (map-ref entry "direction" "") (cons verb args)))
      (display (apply actor-call (entry-actor entry) verb args)))
    nil))

(define (lock . words) (lock-rpc! words lock-usage "lock"))
(define (unlock . words) (lock-rpc! words unlock-usage "unlock"))

(define (recycle name)
  (command name "recycle")
  nil)

; Room ownership decides whether this repair is authorised. The target stays
; unresolved here so the room can match every current child, including a
; direct bare DID that is no longer in the avatar's presentation snapshot.
(define (remove . words)
  (if (null? words)
    (error "usage: remove <child...>")
    (begin
      (display (room-call "remove" (join-words words)))
      nil)))

(define tell-usage "usage: tell <target...> to <verb> [args...]")

; Generic in-world request forwarding: "to" is a hard separator, not just
; style, so a multi-word target description can precede it (e.g. "tell golden
; duckie with peacock feathers to quack"). The resolved target's own
; set-cmd-method!/reply-error decides whether to comply or refuse — tell only
; resolves and relays, exactly like owner/claim do for their one dedicated verb.
(define (tell . words)
  (let* ((s (split-command! words "to" tell-usage #t))
         (target-words (car s))
         (after-to (cadr s))
         (verb (car after-to))
         (args (cdr after-to))
         (reply (apply command (join-words target-words) verb args)))
    ; A bare :ok ack (Nil) carries no information — the target's own :print
    ; broadcast, if any, is the real narrative; only a non-nil reply is worth
    ; showing here.
    (unless (null? reply) (display reply))
    nil))

;; ── Property setters ───────────────────────────────────────────────────────

(define (prop target key . value-words)
  (display (apply command target "prop" key value-words))
  nil)

; `as` separates target from value, so multi-word names and descriptions need
; no quoting: `name golden duckie as The Golden Duckie`.
(define (prop-as-sugar prop-key words)
  (let* ((s (split-command! words "as"
                            (string-append "usage: " prop-key " <target...> as <value...>")
                            #t))
         (target-words (car s))
         (value-words (cadr s)))
    (apply prop (join-words target-words) prop-key value-words)))

(define (name . words) (prop-as-sugar "name" words))
(define (describe . words) (prop-as-sugar "description" words))
(define (nick . words) (prop-as-sugar "nick" words))

      ;; ── Queries and inventory views ─────────────────────────────────────────────
      ;;
      ;; Query RPCs return structured data. The event library owns rendering so the
      ;; same formatters serve solicited replies and unsolicited room events.

(define (here?)
  (room))

;; Meta/inspect — resolve a visible name to its wire DID-URL for direct RPC use.
(define (did? . rest)
  (if (null? rest)
    (error "usage: did? <name...>")
    (display (resolve-one (join-words rest))))
  nil)

(define (who?)
  (event-who (resolve-person-pool))
  nil)

(define (occupants?)
  (event-occupants (room-call "occupants?"))
  nil)

(define (things?)
  (event-things (room-call "things?"))
  nil)

(define (exits?)
  (event-exits (room-call "exits?"))
  nil)

; inv is a pure view: what you hold and what the equipped container holds are
; shown as separate facts. Booking a container as the inventory is equip's
; job, and the view never creates one just because nothing is configured yet.
(define (inv . rest)
  (if (pair? rest)
    (error "usage: inv")
    (let* ((inventory (my-inv-if-any))
           (contents (guard (e (#t ()))
                      (if inventory (container-contents inventory) ())))
           ; the cached ctx supplies the container's name while it still matches
           ; the configured inventory; after a reload only the DID is known, so
           ; the container's own :name answers it (inventory-display-ctx).
           (container (if (and inventory (map? inv-entry)
                               (equal? (entry-actor inv-entry) inventory))
                          inv-entry
                          (if inventory (inventory-display-ctx inventory) inventory))))
      (event-inventory (hand-pool) container contents)
      nil)))

; `help` with no argument shows the avatar's own command list; `help <name>`
; resolves the name (same room/inventory resolver every other verb uses) and
; asks that actor's own `:help` verb for its usage, exactly like `look <name>`.
(define (help . rest)
  (if (pair? rest)
    (display (command (join-words rest) "help"))
    (display
      (string-append
        "go <direction> [secret]  move through a named exit (secret unlocks a locked one)\n"
        "help                    show this command list\n"
        "help <name>             show usage for something here or in your inventory\n"
        "look                    show the current room\n"
        "look <name>             examine something here or in your inventory\n"
        "who?                    list who is here\n"
        "occupants?              list occupants here\n"
        "things?                 list things here\n"
        "exits?                  list exits here\n"
        "here?                   show the current room's address\n"
        "take <name>             pick up something here (drops current held item first)\n"
        "take <name> from <container>  take something out of a container\n"
        "take-from <container> <name>  take something out of a container\n"
        "equip <container> [from <container>]  carry a container as your inventory\n"
        "keep [<item>]           put the held item into your inventory\n"
        "unequip [<inventory>]   take the equipped container back into your hand\n"
        "find <did>              take a hidden object by DID if it's here, on you, or in your inventory\n"
        "drop                    drop what you're holding\n"
        "drop <item>             drop by name (held, or from your inventory)\n"
        "drop <item> from <container>  take it out of a container and drop it here\n"
        "put <item...> in <container...>  put something into a container\n"
        "recycle-from <container> <name>  destroy something inside a container that you own\n"
        "roll-call [<target...>] [begin [secs]|end]  recount a node's children\n"
        "inv                     show what you're holding and what your equipped container holds\n"
        "prop <target> <key> [value...]  set a named prop on any actor\n"
        "name <target...> as <name...>   set the name prop\n"
        "describe <target...> as <text...>  set the description prop\n"
        "nick <target...> as <nick...>   set the nick prop\n"
        "say <text>              say something aloud\n"
        "emote <text>            perform an emote\n"
        "claim <name>            claim ownership of something\n"
        "owner <name>            show who owns something\n"
        "lock <target...> [with <secret>]  lock a container or room exit you own\n"
        "unlock <target...> [with <secret>]  unlock as owner, or with the lock secret\n"
        "recycle <name>          destroy something you own\n"
        "remove <child...>       owner repairs a stale room child\n"
        "dig <direction>         create a new exit\n"
        "fill <direction>        remove an exit\n"
        "forge <kind> named <name...>  create a new thing in your hand (drops current held item first)\n"
        "enter <target> <nick>   enter a room directly by address\n"
        "start-here              trigger the current room to cascade :here to its children\n"
        "leave                   leave the current room\n"
        "\n"
        "--- meta ---\n"
        "did? <name...>          resolve a visible name to its DID-URL for direct RPC")))
  nil)

;; `look` stays with the command vocabulary even though `event-look` renders
;; the result. A no-argument look also refreshes the resolver snapshot cache.
(define (look-entry entry)
  (let ((description (map-ref entry "description" "")))
    (display
      (string-append
        (event-name entry)
        (if (and (string? description) (not (equal? description "")))
          (string-append "\n" description)
          "")))))

(define (look . rest)
  (if (pair? rest)
    (let* ((word (join-words rest))
           (entry
             (if (starts-with-did? word)
               ; Direct DID-URL: search pool, refresh once on miss.
               (let ((pool (default-pool)))
                 (or (find-entry-by-actor pool word)
                     (find-entry-by-actor
                       (begin (remember-room! (room-call "look")) (default-pool))
                       word)))
               (resolve-one-entry-fresh word default-pool))))
      (if entry
        (if (equal? (map-ref entry "kind" "") "container")
          (display (actor-call (entry-actor entry) "look"))
          (look-entry entry))
        (error (string-append word " is not here."))))
    (let ((snapshot (remember-room! (room-call "look"))))
      (if (map? snapshot)
        (event-look snapshot)
        (display snapshot))))
  nil)

;; End of avatar library.
