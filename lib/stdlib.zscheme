;; zscheme stdlib v0.1
;;
;; Userspace implementations of common functions.
;; All of these can be implemented using the core Rust primitives
;; (string-index, substring, string-length, string-append, cons,
;;  car, cdr, null?, pair?, =, <, >, mod, not, display, error).
;;
;; Load with: (include ".my.doc.stdlib")
;; Or from terminal: .my.doc.stdlib!eval
;;
;; Publish to IPFS: .my.doc.stdlib!publish @ma
;; Then share the CID so others can: .my.doc.stdlib!fetch /ipfs/<cid>
;;
;; Nothing in this file knows about DIDs, actors, Zion state, or the network.
;; That is the boundary: if a helper is useful for ordinary Scheme data, it
;; belongs here; if it knows what an MA ctx means, it belongs in runtime.

;; ── List aliases ──────────────────────────────────────────────────────────────

(define (caar x) (car (car x)))
(define (cadr x) (car (cdr x)))
(define (cdar x) (cdr (car x)))
(define (cddr x) (cdr (cdr x)))

(define (caaar x) (car (car (car x))))
(define (caadr x) (car (car (cdr x))))
(define (cadar x) (car (cdr (car x))))
(define (caddr x) (car (cdr (cdr x))))
(define (cdaar x) (cdr (car (car x))))
(define (cdadr x) (cdr (car (cdr x))))
(define (cddar x) (cdr (cdr (car x))))
(define (cdddr x) (cdr (cdr (cdr x))))

(define (caaaar x) (car (car (car (car x)))))
(define (caaadr x) (car (car (car (cdr x)))))
(define (caadar x) (car (car (cdr (car x)))))
(define (caaddr x) (car (car (cdr (cdr x)))))
(define (cadaar x) (car (cdr (car (car x)))))
(define (cadadr x) (car (cdr (car (cdr x)))))
(define (caddar x) (car (cdr (cdr (car x)))))
(define (cadddr x) (car (cdr (cdr (cdr x)))))
(define (cdaaar x) (cdr (car (car (car x)))))
(define (cdaadr x) (cdr (car (car (cdr x)))))
(define (cdadar x) (cdr (car (cdr (car x)))))
(define (cdaddr x) (cdr (car (cdr (cdr x)))))
(define (cddaar x) (cdr (cdr (car (car x)))))
(define (cddadr x) (cdr (cdr (car (cdr x)))))
(define (cdddar x) (cdr (cdr (cdr (car x)))))
(define (cddddr x) (cdr (cdr (cdr (cdr x)))))

;; ── Type predicates ───────────────────────────────────────────────────────────

(define (list? x) (or (null? x) (pair? x)))

;; ── Aliases ───────────────────────────────────────────────────────────────────

(define eq?       equal?)
(define eqv?      equal?)
(define quotient  /)
(define remainder mod)

;; ── List operations ───────────────────────────────────────────────────────────
;;
;; These procedures expect proper lists. We deliberately keep the familiar
;; recursive definitions visible instead of hiding them behind host builtins.

(define (length lst)
  (let loop ((l lst) (n 0))
    (if (null? l) n (loop (cdr l) (+ n 1)))))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

(define (append a b)
  (if (null? a)
      b
      (cons (car a) (append (cdr a) b))))

(define (reverse lst)
  (let loop ((l lst) (acc '()))
    (if (null? l) acc (loop (cdr l) (cons (car l) acc)))))

;; Flatten nested proper lists while leaving every non-list value untouched.
;; Runtime uses this to combine independent resolver result lists.
(define (flatten-list vals)
  (cond ((null? vals) '())
        ((list? (car vals))
         (append (flatten-list (car vals)) (flatten-list (cdr vals))))
        (else (cons (car vals) (flatten-list (cdr vals))))))

(define (map f lst)
  (if (null? lst)
      '()
      (cons (f (car lst)) (map f (cdr lst)))))

(define (filter f lst)
  (cond ((null? lst)       '())
        ((f (car lst))     (cons (car lst) (filter f (cdr lst))))
        (else              (filter f (cdr lst)))))

(define (for-each f lst)
  (unless (null? lst)
    (f (car lst))
    (for-each f (cdr lst))))

  ;; Left fold. `f` receives the current item first and the accumulator second;
  ;; this is the calling convention used throughout the zscheme libraries.
(define (fold f init lst)
  (if (null? lst)
      init
      (fold f (f (car lst) init) (cdr lst))))

(define fold-left fold)

(define (any f lst)
  (cond ((null? lst) #f)
        ((f (car lst)) #t)
        (else (any f (cdr lst)))))

(define (every f lst)
  (cond ((null? lst) #t)
        ((not (f (car lst))) #f)
        (else (every f (cdr lst)))))

;; ── Numeric utilities ─────────────────────────────────────────────────────────

(define (abs n)       (if (< n 0) (- n) n))
(define (max a b)     (if (> a b) a b))
(define (min a b)     (if (< a b) a b))
(define (zero? n)     (= n 0))
(define (positive? n) (> n 0))
(define (negative? n) (< n 0))
(define (even? n)     (= (mod n 2) 0))
(define (odd? n)      (not (even? n)))

;; The direct definition is intentionally here. Besides being lovely Scheme,
;; Fibonacci numbers are useful as a small backoff schedule, and successive
;; non-zero terms approach the golden ratio. Callers needing large terms can
;; add a linear implementation without obscuring this readable one.
(define (fib n)
  (if (< n 2)
      n
      (+ (fib (- n 1)) (fib (- n 2)))))

;; ── String utilities ──────────────────────────────────────────────────────────
;;
;; `string-index` returns #f when there is no match. The helpers below preserve
;; that host convention and turn it into ordinary strings and lists.

(define (string-contains hay needle)
  (not (equal? (string-index hay needle) #f)))

(define (string-split s delim)
  ;; `delim` must be non-empty; an empty delimiter cannot consume input.
  (let ((dlen (string-length delim)))
    (let loop ((rest s) (acc '()))
      (let ((idx (string-index rest delim)))
        (if (equal? idx #f)
            (reverse (cons rest acc))
            (loop (substring rest (+ idx dlen) (string-length rest))
                  (cons (substring rest 0 idx) acc)))))))

(define (string-join lst delim)
  (if (null? lst)
      ""
      (let loop ((rest (cdr lst)) (acc (car lst)))
        (if (null? rest)
            acc
            (loop (cdr rest)
                  (string-append acc delim (car rest)))))))

(define (string-lines s)   (string-split s "\n"))
(define (string-unlines l) (string-join l "\n"))

;; Words from the terminal shorthand arrive as typed literals (numbers,
;; booleans, nil), not just strings; normalise each to its text form so
;; speech verbs and error descriptions never feed a non-string to
;; string-append.
(define (join-words words)
  (string-join
    (map (lambda (word)
           (cond ((string? word) word)
                 ((number? word) (number->string word))
                 ((boolean? word) (if word "#t" "#f"))
                 ((null? word) "")
                 (else (error "join-words: not a word"))))
         words)
    " "))

;; Return the human-facing title line from a multi-line actor reply.
(define (first-line text)
  (let ((index (string-index text "\n")))
    (if index (substring text 0 index) text)))

(define (words-before-keyword words keyword)
  (cond ((null? words) '())
        ((equal? (car words) keyword) '())
        (else
         (cons (car words) (words-before-keyword (cdr words) keyword)))))

;; Unlike `words-before-keyword`, #f means the separator was absent. An empty
;; list means it was present but had no words after it. Command parsers need to
;; distinguish those two cases for useful usage errors.
(define (words-after-keyword words keyword)
  (cond ((null? words) #f)
        ((equal? (car words) keyword) (cdr words))
        (else (words-after-keyword (cdr words) keyword))))

(define (string-trim s)
  (let* ((len (string-length s))
         (start (let loop ((i 0))
                  (if (or (= i len) (not (string-contains " \t\n\r" (substring s i (+ i 1)))))
                      i
                      (loop (+ i 1)))))
         (end   (let loop ((i (- len 1)))
                  (if (or (< i start) (not (string-contains " \t\n\r" (substring s i (+ i 1)))))
                      (+ i 1)
                      (loop (- i 1))))))
    (substring s start end)))

(define (take n lst)
  (if (or (null? lst) (= n 0))
      '()
      (cons (car lst) (take (- n 1) (cdr lst)))))

(define (drop n lst)
  (if (or (null? lst) (= n 0))
      lst
      (drop (- n 1) (cdr lst))))

(define (member? item lst)
  (cond ((null? lst) #f)
        ((equal? item (car lst)) lst)
  (else (member? item (cdr lst)))))

;; Stable de-duplication that keeps the last occurrence of each value. Resolver
;; callers care about a deterministic answer set, not attribute repetition.
(define (unique-list lst)
  (cond ((null? lst) ())
  ((member? (car lst) (cdr lst)) (unique-list (cdr lst)))
        (else (cons (car lst) (unique-list (cdr lst))))))

;; ── Text views ────────────────────────────────────────────────────────────────
;;
;; Small Scheme equivalents of the old host-side :cat/:head/:tail/:wc helpers.
;; `doc-cat` is the one deliberate host-facing edge in stdlib: it evaluates a
;; local document path supplied by the caller; it never fetches remote content.
(define (doc-cat path)
  (eval (string-append "(" path ".content)")))

(define (wc-lines text) (length (string-lines text)))
(define (head-n n text) (string-unlines (take n (string-lines text))))
(define (tail-n n text)
  (let ((lines (string-lines text)))
    (string-unlines (drop (- (length lines) n) lines))))
