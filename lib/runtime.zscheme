;; zscheme runtime library v0.1
;;
;; General helpers for addressing and resolving ma actors.
;; Load stdlib first, then this file:
;;
;;   (include ".my.doc.stdlib")
;;   (include ".my.doc.runtime")
;;
;; Save to .my.doc.runtime:
;;   .my.doc.runtime!edit
;;
;; Publish:   .my.doc.runtime!publish @ma
;; Fetch:     .my.doc.runtime!fetch /ipfs/<cid>
;;
;; This layer understands MA-shaped data but owns no avatar workflow. It turns
;; actor addresses and ctx maps into reusable values; avatar decides what a
;; human command should do with them.

;; Call a method on a full actor DID/DID-URL. A string in function position is
;; the evaluator's actor-call primitive, so this is ordinary Scheme `apply`.
(define (actor-call actor method . args)
  (apply (string-append actor ":" method) args))

;; Reply-shape predicates. ok? is the bare :ok ack (success, no payload);
;; ok-reply? is the (:ok payload) tuple (success carrying a payload). The
;; payload itself is plain (cdr reply). These mirror the ma-zscheme builtins
;; of the same names and may be dropped once a release ships them.
(define (ok? reply)
  (equal? reply ":ok"))

(define (ok-reply? reply)
  (and (pair? reply) (equal? (car reply) ":ok")))

; `#root` is the direct-DID profile's fixed local trust anchor. Unlike
; optional runtime services, its address needs no service-directory lookup.
(define (root)
  (string-append (#.my.ctx.runtime) "#root"))

;; Bare aliases and prose must go through a resolver. Full did:ma: values are
;; already wire-ready and may pass straight through higher-level helpers.
(define (starts-with-did? value)
  (and (string? value)
       (>= (string-length value) 7)
       (equal? (substring value 0 7) "did:ma:")))

(define (entry-actor entry)
  (map-ref entry "actor" (map-ref entry "did" #f)))

;; Presentation code prefers a chosen nick, then a stable name, then an
;; identifier. Keeping this fallback in runtime gives every client the same
;; interpretation of a small ctx map.
(define (event-name ctx)
  (map-ref ctx "nick"
    (map-ref ctx "name"
      (map-ref ctx "did"
        (map-ref ctx "actor" "(unknown)")))))

(define (event-list-values values)
  ;; Runtime actors may publish keyed maps or ordered lists. Consumers resolve
  ;; against one boring list shape instead of branching at every call site.
  (cond ((map? values) (map-values values))
        ((list? values) values)
        (else '())))

(define (find-entry-by-actor pool did)
  (cond ((null? pool) #f)
        ((equal? (entry-actor (car pool)) did) (car pool))
        (else (find-entry-by-actor (cdr pool) did))))

      ;; Preserve the original ctx when available so ambiguity errors can show useful
      ;; names. A synthetic entry still lets a caller work directly with a DID.
(define (candidate-for-did pool did)
  (or (find-entry-by-actor pool did)
      (make-map "did" did "actor" did)))

;; ── Shared object reference resolver ────────────────────────────────────────
;;
;; Runtime.zscheme is the lambda-ma runtime library home for the shared object
;; reference contract. `resolve-ref` is runtime-domain code and is not part of
;; the generic stdlib. The minimum public shape is: a lookup word plus a
;; candidate pool of ctx maps. The result is a plain list of DID strings only —
;; one-element list for a unique answer, multi-element list for ambiguity, empty
;; list for no match. Any presentation layer is a caller concern.
;; `unique-list` is the generic stdlib helper that resolves duplicates inside the
;; result set.

(define (name-matches? word entry key)
  ;; Case-insensitive whole-word match: every word in the query must appear as a
  ;; standalone word in the value. "kiste" matches "Kiste" but not "Guldkiste";
  ;; "wooden box" still matches "Wooden Box".
  (let* ((value (map-ref entry key #f))
         (needle-words (filter (lambda (w) (not (equal? w "")))
                               (string-split (string-downcase word) " "))))
    (and (string? value)
         (not (null? needle-words))
         (let ((haystack-words (filter (lambda (w) (not (equal? w "")))
                                       (string-split (string-downcase value) " "))))
               (fold (lambda (nw acc) (and acc (member? nw haystack-words)))
                 #t
                 needle-words)))))

(define (candidates-by-keys word pool keys)
  ;; Keys express preference. Stop at the first attribute with any matches so
  ;; a strong nick match is not diluted by weaker description matches.
  (if (null? keys)
    ()
    (let ((hits (filter (lambda (entry) (name-matches? word entry (car keys))) pool)))
      (if (null? hits)
        (candidates-by-keys word pool (cdr keys))
        hits))))

(define (resolve-in-pool word pool keys)
  (let ((candidates (candidates-by-keys word pool keys)))
    (if (null? candidates)
      ()
      (map entry-actor candidates))))

(define (resolve-attr word pool attr)
  (resolve-in-pool word pool (list attr)))

(define (resolve-name word pool)
  (resolve-attr word pool "name"))

(define (resolve-nick word pool)
  (resolve-attr word pool "nick"))

(define (resolve-description word pool)
  (resolve-attr word pool "description"))

(define (resolve-ref word pool)
  ;; The broad resolver scans the three public identity attributes separately,
  ;; flattens their DID lists, and removes duplicates caused by one ctx matching
  ;; the same word in more than one attribute.
  (unique-list
    (flatten-list (list (resolve-name word pool)
                         (resolve-nick word pool)
                         (resolve-description word pool)))))